#include "qcom-ipq4019.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/soc/qcom,tcsr.h>

/ {
	model = "Ubiquiti UniFi Travel Router";
	compatible = "ubnt,utr", "qcom,ipq4019";

	memory {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;
	};

	chosen {
		bootargs-append = " ubi.mtd=kernel1 root=/dev/ubiblock0_1 rootfstype=squashfs clk_ignore_unused";
	};

	aliases {
		ethernet0 = &gmac;
	};

	soc {
		tcsr@1949000 {
			compatible = "qcom,tcsr";
			reg = <0x1949000 0x100>;
			qcom,wifi_glb_cfg = <TCSR_WIFI_GLB_CFG>;
		};

		ess_tcsr@1953000 {
			compatible = "qcom,tcsr";
			reg = <0x1953000 0x1000>;
			qcom,ess-interface-select = <TCSR_ESS_PSGMII>;
		};

		tcsr@1957000 {
			compatible = "qcom,tcsr";
			reg = <0x1957000 0x100>;
			qcom,wifi_noc_memtype_m0_m2 = <TCSR_WIFI_NOC_MEMTYPE_M0_M2>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&tlmm 63 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			linux,input-type = <1>;
		};
	};

	backlight: backlight {
		compatible = "gpio-backlight";
		gpios = <&tlmm 2 GPIO_ACTIVE_HIGH>;
		default-on;
	};
};

&prng {
	status = "okay";
};

&crypto {
	status = "okay";
};

&blsp_dma {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&blsp1_uart1 {
	pinctrl-0 = <&serial_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&blsp1_spi1 {
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	status = "okay";

	/*
	 * Vendor DTS used three chip selects on this controller:
	 * CS0 NOR, CS1 SPI NAND, CS2 LCD.
	 */
	cs-gpios = <&tlmm 54 GPIO_ACTIVE_LOW>,
		   <&tlmm 59 GPIO_ACTIVE_LOW>,
		   <&tlmm 4 GPIO_ACTIVE_LOW>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <24000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "SBL1";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "MIBIB";
				reg = <0x40000 0x20000>;
				read-only;
			};

			partition@60000 {
				label = "QSEE";
				reg = <0x60000 0x60000>;
				read-only;
			};

			partition@c0000 {
				label = "CDT";
				reg = <0xc0000 0x10000>;
				read-only;
			};

			partition@d0000 {
				label = "DDRPARAMS";
				reg = <0xd0000 0x10000>;
				read-only;
			};

			partition@e0000 {
				label = "u-boot-env";
				reg = <0xe0000 0x10000>;
			};

			partition@f0000 {
				label = "u-boot";
				reg = <0xf0000 0x1e0000>;
				read-only;
			};

			partition@2d0000 {
				label = "ART";
				reg = <0x2d0000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					precal_art_1000: precal@1000 {
						reg = <0x1000 0x2f20>;
					};

					precal_art_5000: precal@5000 {
						reg = <0x5000 0x2f20>;
					};
				};
			};

			partition@2e0000 {
				label = "EEPROM";
				reg = <0x2e0000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_gmac0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@2f0000 {
				label = "bs";
				reg = <0x2f0000 0x10000>;
			};

			partition@300000 {
				label = "cfg";
				reg = <0x300000 0x100000>;
			};
		};
	};

	spinand@1 {
		compatible = "spi-nand";
		reg = <1>;
		spi-max-frequency = <24000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "kernel0";
				reg = <0x0000000 0x04000000>;
			};

			partition@4000000 {
				label = "kernel1";
				reg = <0x04000000 0x04000000>;
				linux,ubi;
			};
		};
	};

	display@2 {
		compatible = "sitronix,st7789v";
		reg = <2>;
		spi-max-frequency = <24000000>;
		buswidth = <8>;
		dc-gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&tlmm 0 GPIO_ACTIVE_LOW>;	
		backlight = <&backlight>;
	};
};

&tlmm {
	serial_pins: serial_pinmux {
		mux {
			pins = "gpio60", "gpio61";
			function = "blsp_uart0";
			bias-disable;
		};
	};

	spi_0_pins: spi_0_pinmux {
		pinmux {
			function = "blsp_spi0";
			pins = "gpio55", "gpio56", "gpio57";
		};

		/*
		 * Vendor DTS had CS on gpio54, gpio59, and gpio4.
		 */
		pinmux_cs {
			function = "gpio";
			pins = "gpio54", "gpio59", "gpio4";
		};
	};

	mdio_pins: mdio_pins {
		mdc {
			pins = "gpio52";
			function = "mdc";
			bias-pull-up;
		};

		mdio {
			pins = "gpio53";
			function = "mdio";
			bias-pull-up;
		};
	};

	phy_reset_pins: phy_reset_pins {
		phy_reset {
			pins = "gpio62";
			function = "gpio";
			bias-disable;
			output-high;
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>, <&phy_reset_pins>;
	pinctrl-names = "default";
};

&gmac {
	status = "okay";
};

&switch {
	status = "okay";
};

&swport4 {
	status = "okay";
	label = "lan";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_gmac0 1>;
};

&swport5 {
	status = "okay";
	label = "wan";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_gmac0 0>;
};

&wifi0 {
	status = "okay";
	nvmem-cell-names = "pre-calibration";
	nvmem-cells = <&precal_art_1000>;
	qcom,ath10k-calibration-variant = "ap-dk01-c2";
};

&wifi1 {
	status = "okay";
	nvmem-cell-names = "pre-calibration";
	nvmem-cells = <&precal_art_5000>;
	qcom,ath10k-calibration-variant = "ap-dk01-c2";
};

&usb2_hs_phy {
	status = "okay";
};

&usb2 {
	status = "okay";
};

&usb3_hs_phy {
	status = "okay";
};

&usb3_ss_phy {
	status = "okay";
};

&usb3 {
	status = "okay";
};
